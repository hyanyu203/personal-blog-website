# 网易 163 SMTP — 复制为 .env.mail 后填写（.env.mail 已被 gitignore，不会提交）
# 本地后端: docker/scripts/run-backend-with-mail.ps1
# 生产 Docker: 将下列变量合并到 docker/.env（docker compose -f docker-compose.prod.yml 使用）

MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USER=yourname@163.com
MAIL_PASSWORD=your-163-client-auth-code
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_SSL=true

# 启用注册 / 找回密码邮件时设为 true（生产 compose 使用 REGISTRATION_ENABLED）
REGISTRATION_ENABLED=true
