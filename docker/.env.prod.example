# 生产全栈部署 — 复制为 .env 后修改
# 启动: docker compose -f docker-compose.prod.yml up -d --build

# ── 必填 ──────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-jiangou

# ── Redis ─────────────────────────────────────────
REDIS_PASSWORD=change-me-redis

# ── 站点（勿用 localhost：ProdEnvValidator 会拒绝并导致后端无法启动）──
SITE_URL=https://your-domain.com
ADMIN_URL=https://your-domain.com/admin
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ── MySQL JDBC（Docker 内网 MySQL 无 TLS，须显式关闭 SSL）────────
MYSQL_USE_SSL=false
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# ── 限流（仅 Nginx 反代且注入 X-Real-IP 时设为 true）────────────
RATE_LIMIT_TRUST_PROXY=true

# ── MySQL ─────────────────────────────────────────
MYSQL_DATABASE=jiangou
MYSQL_USER=jiangou

# ── MinIO ─────────────────────────────────────────
MINIO_ROOT_USER=jiangou-minio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_ACCESS_KEY=jiangou-minio
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=jiangou
MINIO_PUBLIC_ENDPOINT=https://your-domain.com

# ── 搜索（可选 Meilisearch）────────────────────────
SEARCH_ENGINE=mysql
MEILISEARCH_API_KEY=change-me-meili

# ── 邮件（用户注册/找回密码启用后必填）────────────
# 网易 163 邮箱示例（使用「客户端授权码」，不是登录密码）：
# MAIL_HOST=smtp.163.com
# MAIL_PORT=465
# MAIL_USER=yourname@163.com
# MAIL_PASSWORD=your-163-client-auth-code
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=false
# MAIL_SMTP_SSL=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=false

# ── GitHub（可选）─────────────────────────────────
GITHUB_TOKEN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_ALLOWED_USERNAMES=
GITHUB_OAUTH_REDIRECT_URI=https://your-domain.com/api/v1/auth/github/callback

# ── Cookie 安全（生产 HTTPS 下保持 true）────────────
JWT_COOKIE_SECURE=true

# ── 用户注册（生产默认关闭，启用后需配置 SMTP）──────
REGISTRATION_ENABLED=false

# ── 首个 ADMIN（常规运行保持留空；由 bootstrap 脚本仅在首轮临时注入）──
# bash ./scripts/bootstrap-admin.sh --email <管理员邮箱>
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=

# ── 监控（--profile monitoring，生产必填）──────────
PROMETHEUS_SCRAPE_TOKEN=change-me-prometheus-scrape-token
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=smtp.example.com:587
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=alerts@example.com
GRAFANA_SMTP_FROM_NAME=渐构监控

# ── TLS（可选：生成证书后 nginx 自动启用 HTTPS）────
HTTPS_PORT=443
# bash docker/scripts/generate-self-signed-cert.sh your.domain.com
